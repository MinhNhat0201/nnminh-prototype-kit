{
  "$description": "Base token values of the atelier preset: dark-first, warm neutrals, the brand colour kept for accents and the selected state, surfaces lit by an inset sheen. adopt.py reads this file; the brand palette comes from the designer's seed colour (preset default #f0dd99), everything else from here. Refs as in the shadcn preset; shadows may name semantic tokens in braces ({bg-brand}).",
  "palettes": {
    "neutral": {
      "0": "#ffffff",
      "25": "#fafafa",
      "50": "#f5f5f5",
      "100": "#ebebeb",
      "200": "#dddddd",
      "300": "#bdbdbd",
      "400": "#9e9e9e",
      "500": "#6e6e6e",
      "600": "#545454",
      "700": "#3f3f3f",
      "800": "#2b2b2b",
      "850": "#1f1f1f",
      "900": "#1a1a1a",
      "950": "#141414",
      "1000": "#000000"
    },
    "chart": {
      "2": "#1a9f5a",
      "3": "#e35b00",
      "4": "#545454",
      "5": "#7a6118"
    },
    "chart-dark": {
      "2": "#26bd6c",
      "3": "#ff542e",
      "4": "#9e9e9e",
      "5": "#d9bc5c"
    }
  },
  "generated_palettes": {
    "$description": "Tonal scales 50-950 generated from a seed, like the brand palette.",
    "danger": {
      "seed": "#e6483d",
      "origin": "atelier status danger"
    },
    "warning": {
      "seed": "#e35b00",
      "origin": "atelier orange (the source system has no warning role)"
    },
    "success": {
      "seed": "#26bd6c",
      "origin": "atelier status success"
    },
    "info": {
      "seed": "oklch(0.588 0.158 241)",
      "origin": "kit default (the source system has no info role)"
    }
  },
  "semantic": {
    "bg-canvas": {
      "light": "neutral.50",
      "dark": "neutral.950",
      "alias": "--background"
    },
    "bg-surface": {
      "light": "neutral.0",
      "dark": "neutral.900",
      "alias": "--card"
    },
    "bg-raised": {
      "light": "neutral.0",
      "dark": "neutral.850",
      "alias": "--popover"
    },
    "bg-sidebar": {
      "light": "neutral.25",
      "dark": "neutral.900",
      "alias": "--sidebar"
    },
    "bg-subtle": {
      "light": "neutral.100",
      "dark": "neutral.850",
      "alias": "--muted, --secondary"
    },
    "bg-hover": {
      "light": "neutral.100",
      "dark": "neutral.800",
      "alias": "--accent"
    },
    "bg-pressed": {
      "light": "neutral.200",
      "dark": "neutral.700"
    },
    "bg-disabled": {
      "light": "neutral.100",
      "dark": "neutral.850"
    },
    "bg-inverse": {
      "light": "neutral.950",
      "dark": "neutral.50"
    },
    "bg-scrim": {
      "light": "neutral.950/50",
      "dark": "neutral.1000/60"
    },
    "bg-brand": {
      "light": "brand.seed",
      "dark": "brand.seed",
      "alias": "--primary"
    },
    "bg-brand-hover": {
      "light": "hover:bg-brand",
      "dark": "hover:bg-brand"
    },
    "bg-brand-subtle": {
      "light": "brand.50",
      "dark": "brand.950"
    },
    "bg-selected": {
      "light": "brand.50",
      "dark": "brand.950"
    },
    "bg-danger": {
      "light": "danger.600",
      "dark": "danger.600",
      "alias": "--destructive"
    },
    "bg-danger-hover": {
      "light": "hover:bg-danger",
      "dark": "hover:bg-danger"
    },
    "bg-danger-subtle": {
      "light": "danger.50",
      "dark": "danger.950"
    },
    "bg-success-subtle": {
      "light": "success.50",
      "dark": "success.950"
    },
    "bg-warning-subtle": {
      "light": "warning.50",
      "dark": "warning.950"
    },
    "bg-info-subtle": {
      "light": "info.50",
      "dark": "info.950"
    },
    "stroke-default": {
      "light": "neutral.950/12",
      "dark": "neutral.50/16",
      "alias": "--border"
    },
    "stroke-strong": {
      "light": "neutral.500",
      "dark": "neutral.500",
      "alias": "--input"
    },
    "stroke-focus": {
      "light": "brand.600",
      "dark": "brand.300",
      "alias": "--ring"
    },
    "stroke-brand": {
      "light": "brand.700",
      "dark": "brand.300"
    },
    "stroke-danger": {
      "light": "danger.600",
      "dark": "danger.400"
    },
    "text-primary": {
      "light": "neutral.950",
      "dark": "neutral.50",
      "alias": "--foreground"
    },
    "text-secondary": {
      "light": "neutral.600",
      "dark": "neutral.400",
      "alias": "--muted-foreground"
    },
    "text-disabled": {
      "light": "neutral.400",
      "dark": "neutral.600"
    },
    "text-inverse": {
      "light": "neutral.50",
      "dark": "neutral.950"
    },
    "text-on-brand": {
      "light": "on:bg-brand",
      "dark": "on:bg-brand",
      "alias": "--primary-foreground"
    },
    "text-brand": {
      "light": "brand.700",
      "dark": "brand.200"
    },
    "text-link": {
      "light": "brand.700",
      "dark": "brand.200"
    },
    "text-on-danger": {
      "light": "on:bg-danger",
      "dark": "on:bg-danger"
    },
    "text-danger": {
      "light": "danger.700",
      "dark": "danger.300"
    },
    "text-success": {
      "light": "success.700",
      "dark": "success.300"
    },
    "text-warning": {
      "light": "warning.800",
      "dark": "warning.300"
    },
    "text-info": {
      "light": "info.700",
      "dark": "info.300"
    },
    "icon-primary": {
      "light": "neutral.950",
      "dark": "neutral.50"
    },
    "icon-secondary": {
      "light": "neutral.500",
      "dark": "neutral.400"
    },
    "icon-disabled": {
      "light": "neutral.400",
      "dark": "neutral.600"
    },
    "icon-inverse": {
      "light": "neutral.50",
      "dark": "neutral.950"
    },
    "icon-on-brand": {
      "light": "on:bg-brand",
      "dark": "on:bg-brand"
    },
    "icon-brand": {
      "light": "brand.600",
      "dark": "brand.300"
    },
    "icon-danger": {
      "light": "danger.600",
      "dark": "danger.400"
    },
    "icon-success": {
      "light": "success.600",
      "dark": "success.400"
    },
    "icon-warning": {
      "light": "warning.600",
      "dark": "warning.400"
    },
    "icon-info": {
      "light": "info.600",
      "dark": "info.400"
    },
    "chart-1": {
      "light": "brand.500",
      "dark": "brand.300",
      "alias": "--chart-1"
    },
    "chart-2": {
      "light": "chart.2",
      "dark": "chart-dark.2",
      "alias": "--chart-2"
    },
    "chart-3": {
      "light": "chart.3",
      "dark": "chart-dark.3",
      "alias": "--chart-3"
    },
    "chart-4": {
      "light": "chart.4",
      "dark": "chart-dark.4",
      "alias": "--chart-4"
    },
    "chart-5": {
      "light": "chart.5",
      "dark": "chart-dark.5",
      "alias": "--chart-5"
    }
  },
  "radius": {
    "$description": "Multipliers of the base radius (atelier: sm 4, md 8, lg 10, xl 12, 2xl 16, 3xl 20 at the default 10 px).",
    "default": 10,
    "scale": {
      "sm": 0.4,
      "md": 0.8,
      "lg": 1,
      "xl": 1.2,
      "2xl": 1.6,
      "3xl": 2
    }
  },
  "typography": {
    "family": {
      "sans": "Geist",
      "display": "Manrope",
      "mono": "\"Geist Mono\", ui-monospace"
    },
    "fallback": {
      "sans": "ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Arial, sans-serif",
      "mono": "SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
    },
    "size": {
      "13": 13,
      "14": 14,
      "15": 15,
      "16": 16,
      "18": 18,
      "22": 22,
      "28": 28,
      "32": 32
    },
    "lineHeight": {
      "16": 16,
      "20": 20,
      "24": 24,
      "26": 26,
      "28": 28,
      "34": 34,
      "36": 36
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    },
    "styles": {
      "display": {
        "size": "32",
        "lineHeight": "36",
        "weight": "medium",
        "family": "display"
      },
      "headline": {
        "size": "28",
        "lineHeight": "34",
        "weight": "medium",
        "family": "display"
      },
      "title": {
        "size": "22",
        "lineHeight": "26",
        "weight": "medium",
        "family": "display"
      },
      "subtitle": {
        "size": "18",
        "lineHeight": "24",
        "weight": "medium",
        "family": "display"
      },
      "body-large": {
        "size": "16",
        "lineHeight": "28",
        "weight": "regular"
      },
      "body": {
        "size": "15",
        "lineHeight": "24",
        "weight": "regular"
      },
      "label": {
        "size": "13",
        "lineHeight": "16",
        "weight": "medium",
        "family": "display"
      },
      "caption": {
        "size": "14",
        "lineHeight": "20",
        "weight": "regular"
      }
    }
  },
  "shadow": {
    "light": {
      "xs": "0 1px 2px rgb(20 20 20 / 0.05)",
      "sm": "0 1px 2px rgb(20 20 20 / 0.05), 0 4px 12px -2px rgb(20 20 20 / 0.06)",
      "md": "0 1px 2px rgb(20 20 20 / 0.06), 0 8px 24px -4px rgb(20 20 20 / 0.1)",
      "lg": "0 1px 3px rgb(20 20 20 / 0.08), 0 8px 24px -6px rgb(20 20 20 / 0.14), 0 20px 60px -10px rgb(20 20 20 / 0.12)",
      "button": "0 1px 2px rgb(20 20 20 / 0.08), 0 4px 10px -2px rgb(20 20 20 / 0.08)",
      "glow-brand": "inset 0 1px 0 rgb(255 255 255 / 0.35), 0 1px 2px color-mix(in oklab, {bg-brand} 45%, transparent), 0 6px 14px -6px color-mix(in oklab, {bg-brand} 70%, transparent)",
      "ring": "0 0 0 4px rgb(20 20 20 / 0.08)",
      "ring-focus": "0 0 0 4px color-mix(in oklab, {stroke-focus} 22%, transparent)"
    },
    "dark": {
      "xs": "inset 0 0.56px 1.67px -1.13px rgb(255 255 255 / 0.07), inset 0 1.69px 5.07px -2.25px rgb(255 255 255 / 0.06), inset 0 4.47px 13.4px -3.38px rgb(255 255 255 / 0.05)",
      "sm": "inset 0 0.56px 1.67px -1.13px rgb(255 255 255 / 0.07), inset 0 1.69px 5.07px -2.25px rgb(255 255 255 / 0.06), inset 0 4.47px 13.4px -3.38px rgb(255 255 255 / 0.05), 0 1px 2px rgb(0 0 0 / 0.3)",
      "md": "inset 0 0.71px 1.85px -0.75px rgb(255 255 255 / 0.12), inset 0 1.94px 5.04px -1.5px rgb(255 255 255 / 0.11), inset 0 4.25px 11.06px -2.25px rgb(255 255 255 / 0.11), inset 0 9.44px 24.55px -3px rgb(255 255 255 / 0.09)",
      "lg": "inset 0 0.71px 1.85px -0.75px rgb(255 255 255 / 0.12), inset 0 1.94px 5.04px -1.5px rgb(255 255 255 / 0.11), inset 0 4.25px 11.06px -2.25px rgb(255 255 255 / 0.11), inset 0 9.44px 24.55px -3px rgb(255 255 255 / 0.09), 0 6px 19px -2px rgb(0 0 0 / 0.35), 0 20px 60px -2.5px rgb(0 0 0 / 0.45)",
      "button": "inset 0 0.6px 1.08px -0.92px rgb(255 255 255 / 0.24), inset 0 2.29px 4.12px -1.83px rgb(255 255 255 / 0.24), inset 0 10px 18px -2.75px rgb(255 255 255 / 0.2), 0 0 20px 1px rgb(255 255 255 / 0.03)",
      "glow-brand": "inset 0 0.6px 0.6px -1.25px rgb(255 255 255 / 0.72), inset 0 2.29px 2.29px -2.5px rgb(255 255 255 / 0.64), inset 0 10px 10px -3.75px rgb(255 255 255 / 0.25), 0 2.29px 2.29px -2.5px color-mix(in oklab, {bg-brand} 45%, transparent), 0 10px 10px -3.75px color-mix(in oklab, {bg-brand} 25%, transparent)",
      "ring": "0 0 0 4px rgb(255 255 255 / 0.06)",
      "ring-focus": "0 0 0 4px color-mix(in oklab, {stroke-focus} 25%, transparent)"
    }
  },
  "spacing": {
    "$description": "Primitive 4 px scale plus the atelier steps 18 and 120. Key '0-5' is 2 px.",
    "scale": {
      "0": 0,
      "0-5": 2,
      "1": 4,
      "1-5": 6,
      "2": 8,
      "2-5": 10,
      "3": 12,
      "4": 16,
      "4-5": 18,
      "5": 20,
      "6": 24,
      "7": 28,
      "8": 32,
      "9": 36,
      "10": 40,
      "12": 48,
      "14": 56,
      "16": 64,
      "20": 80,
      "30": 120
    },
    "fixed": {
      "2xs": "0-5",
      "xs": "1",
      "sm": "2",
      "md": "3",
      "lg": "4",
      "xl": "6",
      "2xl": "8",
      "3xl": "12"
    }
  },
  "density": {
    "$description": "Material Design 3 density levels on top of the preset recipes. comfortable = 0 (touch), standard = -1 (preset default h-9), compact = -2.",
    "modes": [
      "comfortable",
      "standard",
      "compact"
    ],
    "tokens": {
      "control-h": {
        "comfortable": "10",
        "standard": "9",
        "compact": "8"
      },
      "control-h-sm": {
        "comfortable": "9",
        "standard": "8",
        "compact": "7"
      },
      "control-h-lg": {
        "comfortable": "12",
        "standard": "10",
        "compact": "9"
      },
      "control-px": {
        "comfortable": "4",
        "standard": "4",
        "compact": "3"
      },
      "control-gap": {
        "comfortable": "2",
        "standard": "2",
        "compact": "1-5"
      },
      "inset": {
        "comfortable": "6",
        "standard": "5",
        "compact": "4"
      },
      "stack": {
        "comfortable": "4",
        "standard": "3",
        "compact": "2"
      },
      "row-h": {
        "comfortable": "14",
        "standard": "12",
        "compact": "10"
      },
      "cell-px": {
        "comfortable": "4",
        "standard": "3",
        "compact": "2"
      },
      "cell-py": {
        "comfortable": "3",
        "standard": "2",
        "compact": "1-5"
      }
    }
  },
  "size": {
    "$description": "Fixed component sizes in px. Structure values follow Material Design 3; control visuals follow the preset.",
    "touch-target": 48,
    "border": 1,
    "focus-ring": 2,
    "focus-offset": 2,
    "icon-sm": 16,
    "icon-md": 20,
    "icon-lg": 24,
    "check": 16,
    "switch-w": 36,
    "switch-h": 20,
    "chip-h": 32,
    "badge-h": 20,
    "dot": 8,
    "progress-h": 8,
    "spinner-stroke": 2,
    "avatar-sm": 32,
    "avatar-md": 40,
    "avatar-lg": 56,
    "avatar-ring": 2,
    "topbar-h": 64,
    "rail-w": 80,
    "tabbar-h": 64,
    "indicator-w": 56,
    "indicator-h": 32,
    "fab": 56,
    "fab-sm": 40,
    "sheet-handle-w": 32,
    "sheet-handle-h": 4,
    "dialog-w": 512,
    "container": 1200,
    "sheet-w": 640,
    "toast-w": 400,
    "menu-w": 192,
    "tooltip-w": 280
  },
  "motion": {
    "fast": "200ms",
    "normal": "300ms",
    "slow": "400ms",
    "easing": "cubic-bezier(0.22, 1, 0.36, 1)"
  },
  "z": {
    "sticky": 10,
    "overlay": 40,
    "toast": 50,
    "tooltip": 60
  }
}
